pipeline {

    agent none

    environment {
        PYTHON = "python"
    }

    stages {

        stage('Get Code') {

            agent { label 'windows1' }

            steps {
                git 'https://github.com/Anripasper/helloworldp26.git'
                stash name: 'source', includes: '**/*'
            }
        }

        stage('Quality Parallel') {

            parallel {

                stage('Unit') {

                    agent { label 'windows1' }

                    steps {

                        unstash 'source'

                        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                            bat '''
                            whoami
                            hostname

                            set PYTHONPATH=%WORKSPACE%
                            %PYTHON% -m pytest --junitxml=result-unit.xml test\\unit
                            '''
                        }
                    }

                    post {
                        always {
                            junit 'result-unit.xml'
                        }
                    }
                }

                stage('Static') {

                    agent { label 'windows2' }

                    steps {

                        unstash 'source'

                        bat '''
                        whoami
                        hostname

                        %PYTHON% -m flake8 --exit-zero --format=pylint app > flake8.out
                        '''

                        recordIssues(
                            tools: [flake8(name: 'Flake8', pattern: 'flake8.out')],
                            qualityGates: [
                                [threshold: 8, type: 'TOTAL', unstable: true],
                                [threshold: 10, type: 'TOTAL', failed: true]
                            ]
                        )
                    }
                }

                stage('Security') {

                    agent { label 'windows2' }

                    steps {

                        unstash 'source'

                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            bat '''
                            whoami
                            hostname

                            %PYTHON% -m bandit -r . -f custom -o bandit.out --exit-zero --msg-template "{abspath}:{line}: [{test_id}] {msg}"
                            '''

                            recordIssues(
                                tools: [pyLint(name: 'Bandit', pattern: 'bandit.out')],
                                qualityGates: [
                                    [threshold: 2, type: 'TOTAL', unstable: true],
                                    [threshold: 4, type: 'TOTAL', failed: true]
                                ]
                            )
                        }
                    }
                }

                stage('Coverage') {

                    agent { label 'windows1' }

                    steps {

                        unstash 'source'

                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                            bat '''
                            whoami
                            hostname

                            %PYTHON% -m coverage run --branch --source=app --omit=app\\__init__.py,app\\api.py -m pytest test\\unit
                            %PYTHON% -m coverage xml
                            '''
                        }

                        recordCoverage(
                            tools: [[parser: 'COBERTURA', pattern: 'coverage.xml']],
                            qualityGates: [
                                [metric: 'LINE', threshold: 85.0, criticality: 'ERROR'],
                                [metric: 'LINE', threshold: 95.0],
                                [metric: 'BRANCH', threshold: 80.0, criticality: 'ERROR'],
                                [metric: 'BRANCH', threshold: 90.0]
                            ]
                        )
                    }
                }
            }
        }

        stage('Rest') {

            agent { label 'windows1' }

            steps {

                unstash 'source'

                catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {

                    bat '''
                    whoami
                    hostname

                    echo === CONFIGURANDO FLASK ===
                    set FLASK_APP=app\\api.py
                    set FLASK_ENV=development

                    echo === ARRANCANDO FLASK ===
                    start "" /B "C:\\Users\\anrip\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m flask run --port=5000

                    echo === ARRANCANDO WIREMOCK ===
                    start "" /B java -jar C:\\UNIR\\Ejercicios\\wiremock\\wiremock-standalone-3.13.2.jar --port 9090 --root-dir %WORKSPACE%\\test\\wiremock

                    echo === ESPERANDO SERVICIOS ===

                    echo === EJECUTANDO TESTS ===
                    set PYTHONPATH=%WORKSPACE%

                    "C:\\Users\\anrip\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m pytest --junitxml=result.xml test\\rest
                    '''
                }
            }
        }

        stage('Performance') {

            agent { label 'windows2' }

            steps {

                unstash 'source'

                bat '''
                whoami
                hostname

                set FLASK_APP=app\\api.py
                set FLASK_ENV=development

                start "" /B %PYTHON% -m flask run --port=5000

                echo === ESPERANDO A QUE FLASK RESPONDA ===

                :waitloop
                curl http://127.0.0.1:5000 >nul 2>&1

                if errorlevel 1 (
                    echo Flask aun no responde...
                    timeout /t 2 >nul
                    goto waitloop
                )

                C:\\Users\\anrip\\Downloads\\apache-jmeter-5.6.3\\apache-jmeter-5.6.3\\bin\\jmeter -n -t test\\jmeter\\flask.jmx -l flask.jtl
                '''

                perfReport(
                    sourceDataFiles: 'flask.jtl',
                    errorFailedThreshold: 5,
                    errorUnstableThreshold: 1
                )
            }
        }
    }
}
